{
  "name": "ganesh-navarathri-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Ganesh Navarathri Donation & Expense Management — a static, offline-capable web app for tracking festival donations, expenses, auctions and year-wise balances.",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "npm run icons && vite",
    "prebuild": "npm run icons",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "chart.js": "^4.4.4",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.3",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "fake-indexeddb": "^4.0.2",
    "typescript": "^5.5.4",
    "vite": "^4.5.5",
    "vite-plugin-pwa": "^0.16.7",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=16.14.0"
  },
  "overrides": {
    "vite": "^4.5.5",
    "workbox-build": "^6.6.0"
  }
}
